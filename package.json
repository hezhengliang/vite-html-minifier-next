{
  "name": "vite-html-minifier-next",
  "version": "1.0.0",
  "description": "A Vite plugin for minifying HTML in production builds.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "MIT",
  "keywords": [
    "vite",
    "minify-html",
    "vite-plugin",
    "vite-html-minifier-next"
  ],
  "homepage": "https://github.com/hezhengliang/vite-html-minifier-next#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hezhengliang/vite-html-minifier-next.git"
  },
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "html-minifier-next": "~6.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.1.0",
    "prettier": "^3.3.3",
    "tsdown": "^0.22.0",
    "typescript": "^5.5.4",
    "vite": ">=6"
  }
}
